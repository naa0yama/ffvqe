// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python3",
	"dockerFile": "../Dockerfile",
	"postCreateCommand": "./.devcontainer/postCreateCommand.sh",
	"runArgs": [
		"--device=/dev/dri:/dev/dri",
		"--group-add=video",
		"--group-add=render"
	],
	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Add another local file mount.
	"mounts": [
		// Claude Code
		"type=bind,source=${localEnv:HOME}/.claude,target=/home/cuser/.claude,consistency=cached",
		// Git
		"type=bind,source=${localEnv:HOME}/.gitignore_global,target=/home/cuser/.gitignore_global,consistency=cached",
		// GitHub
		"type=bind,source=${localEnv:HOME}/.config/gh,target=/home/cuser/.config/gh,consistency=cached"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code", // 					Claude Code for VSCode
				"charliermarsh.ruff", // 						Ruff
				"christian-kohler.path-intellisense", // 		Path Intellisense
				"DavidAnson.vscode-markdownlint", // 			markdownlint
				"dprint.dprint", // 							Dprint Code Formatter
				"EditorConfig.EditorConfig", // 				EditorConfig for VS Code
				"Gruntfuggly.todo-tree", // 					Todo Tree
				"janisdd.vscode-edit-csv", // 					Edit CSV
				"littlefoxteam.vscode-python-test-adapter", // 	Python Test Explorer for Visual Studio Code
				"markis.code-coverage", // 						Code Coverage
				"ms-azuretools.vscode-containers", // 			Container Tools
				"ms-azuretools.vscode-docker", // 				Docker
				"ms-python.mypy-type-checker", // 				Mypy Type Checker
				"ms-python.python", // 							Python
				"ms-python.vscode-pylance", // 					Pylance
				"ms-vscode-remote.remote-containers", // 		Dev Containers
				"ms-vscode-remote.remote-wsl", // 				WSL
				"njpwerner.autodocstring", // 					autoDocstring - Python Docstring Generator
				"redhat.vscode-yaml", // 						YAML
				"ruiquelhas.vscode-lowercase", // 				lowercase
				"ruiquelhas.vscode-uppercase", // 				uppercase
				"ryanluker.vscode-coverage-gutters", // 		Coverage Gutters
				"ryu1kn.partial-diff", // 						Partial Diff
				"tamasfe.even-better-toml", // 					Even Better TOML
				"usernamehw.errorlens", // 						Error Lens
				"wholroyd.jinja", // 							Jinja
				"xyz.local-history", // 						Local History
				"yzhang.markdown-all-in-one" // 				Markdown All in One
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "cuser"
}
